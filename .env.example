# Server
PORT=3010
HOST=0.0.0.0
NODE_ENV=development

# Auth (rint-app calls this service with Bearer token)
VISIBILITY_API_KEY=change-me

# Supabase (v1 product data — rint schema; migrations in this repo)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers — validation phase: Claude only (see probe-runner PROVIDERS)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Parked for later (ChatGPT + Gemini multi-provider probes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Async diagnostics
# When REDIS_URL is set, API enqueues jobs in BullMQ and src/worker.ts processes them.
# Without REDIS_URL, diagnostics run in-process for local/dev/test.
REDIS_URL=
DIAGNOSTIC_MAX_SKUS=3
DIAGNOSTIC_MAX_QUERIES_PER_SKU=5
DIAGNOSTIC_JOB_ATTEMPTS=3
DIAGNOSTIC_JOB_BACKOFF_MS=30000
DIAGNOSTIC_WEBHOOK_SECRET=
