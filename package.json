{
  "name": "rint-visibility",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rint v1 engine — AI visibility probes, weekly score, catalog fixes",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server.ts",
    "dev:worker": "tsx watch --env-file=.env.local src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "npm run typecheck && npm test && npm run db:guard && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:guard": "node scripts/db/guard-migrations.mjs",
    "db:guard:history": "node scripts/db/guard-history.mjs"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bullmq": "^6.1.1",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^25.9.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
